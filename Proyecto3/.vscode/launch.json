{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension (RNN C Autocomplete)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceRoot}/rnn-keras-autocomplete/vscode-extension"
      ]
    }
  ]
}
